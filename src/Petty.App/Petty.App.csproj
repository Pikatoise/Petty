<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Petty.App</RootNamespace>
    <AssemblyName>Petty</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by the asset pipeline; also gives the wizard/settings title bars an icon. -->
    <ApplicationIcon>..\..\assets\sprites\petty.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- The repo builds invariant by default; WPF's text caret asks for the input
         language's CultureInfo and throws in invariant mode, so the app needs real cultures. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- DllImport keeps the Win32 interop readable; the source generator is optional here.
         WFO0003: the per-monitor DPI manifest is what WPF's pixel alignment was verified with. -->
    <NoWarn>$(NoWarn);SYSLIB1054;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms interop is opt-in per file; keep its implicit usings out of WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Petty.Core\Petty.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\sprites\cat-orange-white.png"
             Link="Assets\Sprites\cat-orange-white.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sprites\cat-orange-white.json"
             Link="Assets\Sprites\cat-orange-white.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sprites\tray-cat.png"
             Link="Assets\Sprites\tray-cat.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
