<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Petty.App</RootNamespace>
    <AssemblyName>Petty</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by the asset pipeline; also gives the wizard/settings title bars an icon. -->
    <ApplicationIcon>..\..\assets\sprites\petty.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Desktop integration uses P/Invoke, not Windows Runtime projections. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- The repo builds invariant by default; WPF's text caret asks for the input
         language's CultureInfo and throws in invariant mode, so the app needs real cultures. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- DllImport keeps the Win32 interop readable; the source generator is optional here.
         WFO0003: the per-monitor DPI manifest is what WPF's pixel alignment was verified with. -->
    <NoWarn>$(NoWarn);SYSLIB1054;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms interop is opt-in per file; keep its implicit usings out of WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Views\DebugWindow.xaml;Views\DebugParameterControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\sprites\tray-cat.png" Link="Resources\AppIcon.png" />
    <ProjectReference Include="..\Petty.Core\Petty.Core.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgWPF-UI)\LICENSE.md;$(PkgWPF-UI)\ThirdPartyNotices.txt"
             Link="licenses\WPF-UI\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sprites\*.png;..\..\assets\sprites\*.json"
             Exclude="..\..\assets\sprites\catalog.json"
             Link="Assets\Sprites\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sprites\packs\**\*.png;..\..\assets\sprites\packs\**\*.json"
             Link="Assets\Sprites\packs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
