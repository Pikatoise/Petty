<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Petty.App.Views.TutorialWindow"
    Title="{DynamicResource TutorialTitle}"
    Width="520"
    Height="540"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/CozyControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="TutorialArrowButton"
                TargetType="Button"
                BasedOn="{StaticResource CozyButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="20" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{DynamicResource TutorialTitle}"
                FontSize="22"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="PagePosition"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource CozyMuted}" />
        </Grid>
        <Frame
            x:Name="PageFrame"
            Grid.Row="1"
            NavigationUIVisibility="Hidden"
            JournalOwnership="OwnsJournal"
            Navigated="OnPageNavigated"
            BorderThickness="0"
            Focusable="False" />
        <StackPanel Grid.Row="2">
            <TextBlock
                x:Name="ErrorText"
                Foreground="#B00020"
                TextWrapping="Wrap" />
            <Grid
                Margin="0,12,0,0"
                x:Name="NavigationPanel"
                Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousButton"
                    Content="←"
                    Style="{StaticResource TutorialArrowButton}"
                    Click="OnPrevious"
                    ToolTip="{DynamicResource TutorialPrevious}"
                    AutomationProperties.Name="{DynamicResource TutorialPrevious}" />
                <Button
                    x:Name="SkipButton"
                    Grid.Column="1"
                    Content="{DynamicResource TutorialSkip}"
                    Style="{StaticResource CozyButton}"
                    MinWidth="0"
                    Padding="8"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="6,0"
                    Click="OnFinish" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Content="→"
                    Style="{StaticResource TutorialArrowButton}"
                    MinWidth="0"
                    MinHeight="36"
                    Click="OnNext"
                    IsDefault="True"
                    ToolTip="{DynamicResource TutorialNext}"
                    AutomationProperties.Name="{DynamicResource TutorialNext}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
