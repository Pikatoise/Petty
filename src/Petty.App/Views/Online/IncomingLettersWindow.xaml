<online:OnlineWindow
    x:Class="Petty.App.Views.Online.IncomingLettersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:online="clr-namespace:Petty.App.Views.Online"
    Title="{DynamicResource OnlineIncomingLetters}">
    <Border Padding="24">
        <DockPanel>
            <TextBlock
                x:Name="StatusText"
                DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                AutomationProperties.LiveSetting="Polite" />
            <Button
                DockPanel.Dock="Bottom"
                Content="{DynamicResource OnlineReadAll}"
                Click="OnReadAll"
                HorizontalAlignment="Left" />
            <StackPanel DockPanel.Dock="Top">
                <TextBlock
                    Text="{DynamicResource OnlineIncomingLetters}"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12" />
                <TextBlock x:Name="SenderText" Margin="0,0,0,12" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LettersPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</online:OnlineWindow>
