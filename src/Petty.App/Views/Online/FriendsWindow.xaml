<online:OnlineWindow
    x:Class="Petty.App.Views.Online.FriendsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:online="clr-namespace:Petty.App.Views.Online"
    Title="{DynamicResource OnlineFriends}">
    <Border Padding="24">
        <DockPanel>
            <TextBlock
                x:Name="StatusText"
                DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer
                x:Name="FriendsScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock
                        Text="{DynamicResource OnlineFriends}"
                        FontSize="22"
                        FontWeight="SemiBold" />
                    <Label Content="{DynamicResource OnlineExactLogin}" Target="{Binding ElementName=LoginBox}" />
                    <TextBox
                        x:Name="LoginBox"
                        MaxLength="32"
                        AutomationProperties.Name="{DynamicResource OnlineExactLogin}" />
                    <WrapPanel>
                        <Button Content="{DynamicResource OnlineAddFriend}" Click="OnAdd" />
                        <Button Content="{DynamicResource OnlineRefresh}" Click="OnRefresh" />
                    </WrapPanel>
                    <TextBlock
                        Text="{DynamicResource OnlineFriends}"
                        FontWeight="SemiBold"
                        Margin="0,14,0,4" />
                    <StackPanel x:Name="FriendsPanel" />
                    <TextBlock
                        Text="{DynamicResource OnlineIncomingRequests}"
                        FontWeight="SemiBold"
                        Margin="0,14,0,4" />
                    <StackPanel x:Name="IncomingPanel" />
                    <TextBlock
                        Text="{DynamicResource OnlineOutgoingRequests}"
                        FontWeight="SemiBold"
                        Margin="0,14,0,4" />
                    <StackPanel x:Name="OutgoingPanel" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</online:OnlineWindow>
