<UserControl
    x:Class="Petty.App.Views.Online.SocialDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    PreviewKeyDown="OnKeyDown"
    Foreground="{DynamicResource CozyText}">
    <UserControl.Resources>
        <ResourceDictionary Source="/Petty;component/Resources/OnlineControls.xaml" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer
            x:Name="DashboardScroll"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18">
                <DockPanel Margin="0,0,0,12">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource OnlineIconButton}"
                        ToolTip="{DynamicResource OnlineLogout}"
                        AutomationProperties.Name="{DynamicResource OnlineLogout}"
                        Click="OnLogout">
                        <ui:SymbolIcon Symbol="SignOut24" FontSize="20" />
                    </Button>
                    <TextBlock
                        x:Name="UserLogin"
                        FontSize="24"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
                <Button
                    Content="{DynamicResource OnlineAddFriend}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"
                    Click="OnShowAdd" />
                <TextBlock
                    x:Name="LoadingText"
                    Text="{DynamicResource OnlineWorking}"
                    Foreground="{StaticResource CozyMuted}"
                    Margin="4,0,0,6" />
                <Expander
                    Style="{StaticResource OnlineSection}"
                    x:Name="FriendsSection"
                    IsExpanded="True"
                    Margin="0,5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource OnlineFriends}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Items.Count, ElementName=FriendsList, StringFormat=' ({0})'}" Foreground="{StaticResource CozyMuted}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,2">
                        <ItemsControl x:Name="FriendsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        CornerRadius="24"
                                        Background="{StaticResource CozySurface}"
                                        Margin="0,3"
                                        Padding="14,0,6,0"
                                        Height="48">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineConversation}"
                                                    AutomationProperties.Name="{DynamicResource OnlineConversation}"
                                                    Tag="{Binding}"
                                                    Click="OnHistory">
                                                    <ui:SymbolIcon
                                                        Symbol="History24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineBlock}"
                                                    AutomationProperties.Name="{DynamicResource OnlineBlock}"
                                                    Tag="{Binding}"
                                                    Click="OnBlock">
                                                    <ui:SymbolIcon
                                                        Symbol="Prohibited24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineRemove}"
                                                    AutomationProperties.Name="{DynamicResource OnlineRemove}"
                                                    Tag="{Binding}"
                                                    Click="OnRemove">
                                                    <ui:SymbolIcon
                                                        Symbol="Dismiss24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding Login}"
                                                ToolTip="{Binding Login}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Text="{DynamicResource OnlineEmpty}"
                            Foreground="{StaticResource CozyMuted}"
                            Margin="12,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=FriendsList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
                <Expander
                    Style="{StaticResource OnlineSection}"
                    x:Name="IncomingSection"
                    IsExpanded="False"
                    Margin="0,5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource OnlineIncomingRequests}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Items.Count, ElementName=IncomingList, StringFormat=' ({0})'}" Foreground="{StaticResource CozyMuted}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,2">
                        <ItemsControl x:Name="IncomingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        CornerRadius="24"
                                        Background="{StaticResource CozySurface}"
                                        Margin="0,3"
                                        Padding="14,0,6,0"
                                        Height="48">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineAccept}"
                                                    AutomationProperties.Name="{DynamicResource OnlineAccept}"
                                                    Tag="{Binding}"
                                                    Click="OnAccept">
                                                    <ui:SymbolIcon
                                                        Symbol="Checkmark24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineDecline}"
                                                    AutomationProperties.Name="{DynamicResource OnlineDecline}"
                                                    Tag="{Binding}"
                                                    Click="OnDecline">
                                                    <ui:SymbolIcon
                                                        Symbol="Dismiss24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding Login}"
                                                ToolTip="{Binding Login}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Text="{DynamicResource OnlineEmpty}"
                            Foreground="{StaticResource CozyMuted}"
                            Margin="12,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=IncomingList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
                <Expander
                    Style="{StaticResource OnlineSection}"
                    x:Name="OutgoingSection"
                    IsExpanded="False"
                    Margin="0,5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource OnlineOutgoingRequests}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Items.Count, ElementName=OutgoingList, StringFormat=' ({0})'}" Foreground="{StaticResource CozyMuted}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,2">
                        <ItemsControl x:Name="OutgoingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        CornerRadius="24"
                                        Background="{StaticResource CozySurface}"
                                        Margin="0,3"
                                        Padding="14,0,6,0"
                                        Height="48">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineCancelRequest}"
                                                    AutomationProperties.Name="{DynamicResource OnlineCancelRequest}"
                                                    Tag="{Binding}"
                                                    Click="OnCancel">
                                                    <ui:SymbolIcon
                                                        Symbol="Dismiss24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding Login}"
                                                ToolTip="{Binding Login}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Text="{DynamicResource OnlineEmpty}"
                            Foreground="{StaticResource CozyMuted}"
                            Margin="12,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=OutgoingList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
                <Expander
                    Style="{StaticResource OnlineSection}"
                    x:Name="BlockedSection"
                    IsExpanded="False"
                    Margin="0,5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource OnlineBlockedUsers}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Items.Count, ElementName=BlockedList, StringFormat=' ({0})'}" Foreground="{StaticResource CozyMuted}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,6,0,2">
                        <ItemsControl x:Name="BlockedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        CornerRadius="24"
                                        Background="{StaticResource CozySurface}"
                                        Margin="0,3"
                                        Padding="14,0,6,0"
                                        Height="48">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource OnlineIconButton}"
                                                    ToolTip="{DynamicResource OnlineUnblock}"
                                                    AutomationProperties.Name="{DynamicResource OnlineUnblock}"
                                                    Tag="{Binding}"
                                                    Click="OnUnblock">
                                                    <ui:SymbolIcon
                                                        Symbol="LockOpen24"
                                                        FontSize="18"
                                                        IsHitTestVisible="False" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding Login}"
                                                ToolTip="{Binding Login}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Text="{DynamicResource OnlineEmpty}"
                            Foreground="{StaticResource CozyMuted}"
                            Margin="12,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=BlockedList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid
            x:Name="Modal"
            Visibility="Collapsed"
            Background="#66000000"
            KeyboardNavigation.TabNavigation="Cycle">
            <Border
                Margin="28"
                Padding="18"
                CornerRadius="14"
                Background="{StaticResource CozyBackground}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                VerticalAlignment="Center">
                <StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Style="{StaticResource OnlineIconButton}"
                        ToolTip="{DynamicResource OnlineClose}"
                        AutomationProperties.Name="{DynamicResource OnlineClose}"
                        Click="OnCloseModal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </Button>
                    <StackPanel x:Name="AddForm">
                        <TextBox
                            x:Name="FriendLogin"
                            MaxLength="32"
                            ToolTip="{DynamicResource OnlineExactLogin}"
                            AutomationProperties.Name="{DynamicResource OnlineExactLogin}" />
                        <Button
                            x:Name="AddButton"
                            Content="{DynamicResource OnlineAdd}"
                            Click="OnAdd" />
                    </StackPanel>
                    <StackPanel x:Name="ConfirmationForm" Visibility="Collapsed">
                        <TextBlock x:Name="ConfirmationText" Margin="0,4,0,12" />
                        <Button x:Name="ConfirmButton" Click="OnConfirm" />
                        <Button Content="{DynamicResource OnlineCancel}" Click="OnCloseModal" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
