<online:OnlineWindow
    x:Class="Petty.App.Views.Online.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:online="clr-namespace:Petty.App.Views.Online"
    Title="{DynamicResource OnlineAccount}">
    <Border Padding="24">
        <DockPanel>
            <TextBlock
                x:Name="StatusText"
                DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock
                        Text="{DynamicResource OnlineAccount}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Margin="0,0,0,16" />
                    <TextBlock x:Name="AccountText" Margin="0,0,0,12" />
                    <StackPanel x:Name="CredentialsPanel">
                        <Label Content="{DynamicResource OnlineLogin}" Target="{Binding ElementName=LoginBox}" />
                        <TextBox
                            x:Name="LoginBox"
                            MaxLength="32"
                            AutomationProperties.Name="{DynamicResource OnlineLogin}" />
                        <Label Content="{DynamicResource OnlinePassword}" Target="{Binding ElementName=PasswordBox}" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            MaxLength="128"
                            AutomationProperties.Name="{DynamicResource OnlinePassword}" />
                        <Label Content="{DynamicResource OnlineConfirmPassword}" Target="{Binding ElementName=ConfirmBox}" />
                        <PasswordBox
                            x:Name="ConfirmBox"
                            MaxLength="128"
                            AutomationProperties.Name="{DynamicResource OnlineConfirmPassword}" />
                        <TextBlock
                            Text="{DynamicResource OnlineRegistrationNotice}"
                            Foreground="{StaticResource CozyMuted}"
                            Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button
                                Content="{DynamicResource OnlineSignIn}"
                                Click="OnLogin"
                                IsDefault="True" />
                            <Button Content="{DynamicResource OnlineRegister}" Click="OnRegister" />
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel x:Name="AccountActions" Visibility="Collapsed">
                        <Button Content="{DynamicResource OnlineFriends}" Click="OnFriends" />
                        <Button Content="{DynamicResource OnlineCompose}" Click="OnCompose" />
                        <Button Content="{DynamicResource OnlineSent}" Click="OnSent" />
                        <Button Content="{DynamicResource OnlineReceived}" Click="OnReceived" />
                        <Button Content="{DynamicResource OnlineLogout}" Click="OnLogout" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</online:OnlineWindow>
