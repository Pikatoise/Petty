<online:OnlineWindow
    x:Class="Petty.App.Views.Online.LettersHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:online="clr-namespace:Petty.App.Views.Online">
    <Border Padding="24">
        <DockPanel>
            <TextBlock
                x:Name="StatusText"
                DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                AutomationProperties.LiveSetting="Polite" />
            <StackPanel DockPanel.Dock="Top">
                <TextBlock
                    x:Name="HeadingText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12" />
                <WrapPanel>
                    <Button Content="{DynamicResource OnlineRefresh}" Click="OnRefresh" />
                    <Button
                        x:Name="MoreButton"
                        Content="{DynamicResource OnlineMore}"
                        Click="OnMore"
                        IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LettersPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</online:OnlineWindow>
