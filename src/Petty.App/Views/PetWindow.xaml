<Window x:Class="Petty.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Petty"
        Width="192"
        Height="192"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        RenderOptions.EdgeMode="Aliased">
    <Grid x:Name="Root" Background="Transparent">
        <Image x:Name="SpriteImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="FlipTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Shown while the pointer is over the cat; clicking it starts play. -->
        <Border x:Name="PlayChip"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Padding="9,2,9,3"
                Background="#FFF3DC"
                BorderBrush="#2B1A12"
                BorderThickness="2">
            <TextBlock Text="Play"
                       FontFamily="Consolas"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#2B1A12" />
        </Border>
    </Grid>
</Window>


