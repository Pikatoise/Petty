<Window
    x:Class="Petty.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource SettingsTitle}"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="../Resources/CozyControls.xaml" />
    </Window.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="{StaticResource CozyBackground}">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{DynamicResource SettingsTitle}"
                    FontSize="22"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource CozyButton}"
                    Width="32"
                    Height="32"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="4"
                    Margin="12,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    ToolTip="{DynamicResource Licenses}"
                    AutomationProperties.Name="{DynamicResource Licenses}"
                    Click="OnLicenses">
                    <ui:SymbolIcon
                        Symbol="Info24"
                        FontSize="22"
                        IsHitTestVisible="False" />
                </Button>
            </Grid>
            <Border
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{DynamicResource PetSettings}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="TutorialButton"
                            Grid.Column="1"
                            Content="{DynamicResource TutorialOpen}"
                            Style="{StaticResource CozyButton}"
                            MinWidth="0"
                            Padding="10,5"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="OnTutorial" />
                    </Grid>
                    <TextBlock Text="{DynamicResource PetName}" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="NameBox"
                        Style="{StaticResource CozyInput}"
                        MaxLength="24"
                        Margin="0,4,0,0"
                        TextChanged="OnNameChanged"
                        LostKeyboardFocus="OnNameLostFocus" />
                    <TextBlock
                        x:Name="StatusText"
                        MinHeight="18"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="AppearanceText"
                        Foreground="{StaticResource CozyMuted}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock
                        Text="{DynamicResource ProgramSettings}"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12" />
                    <TextBlock
                        Text="{DynamicResource Language}"
                        FontWeight="SemiBold"
                        Margin="0,0,0,4" />
                    <ComboBox
                        x:Name="LanguageSelector"
                        Style="{StaticResource CozySelection}"
                        SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="{DynamicResource LanguageSystem}" Tag="system" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <CheckBox
                        x:Name="AutostartCheck"
                        Content="{DynamicResource Autostart}"
                        Margin="0,14,0,0"
                        Checked="OnAutostartChanged"
                        Unchecked="OnAutostartChanged" />
                    <TextBlock
                        x:Name="ProgramStatusText"
                        Foreground="#B00020"
                        TextWrapping="Wrap"
                        Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,20,0,0">
                <Button
                    x:Name="NewPetButton"
                    Content="{DynamicResource CreateNew}"
                    Style="{StaticResource CozyButton}"
                    Click="OnNewPet"
                    HorizontalAlignment="Left"
                    Margin="0,0,12,0" />
                <Button
                    x:Name="CloseButton"
                    Content="{DynamicResource Close}"
                    Style="{StaticResource CozyButton}"
                    Click="OnClose"
                    IsCancel="True" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
