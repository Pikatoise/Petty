<Window x:Class="Petty.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Petty settings"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2"
        FontFamily="Segoe UI">
    <StackPanel Margin="18">
        <TextBlock Text="Pet name" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" MaxLength="24" Padding="4,2" Margin="0,4,0,0" />
        <TextBlock x:Name="StatusText" MinHeight="18" Margin="0,3,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="AppearanceText"
                   Foreground="#6B6258"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Create a new pet…"
                    Click="OnNewPet"
                    Padding="10,3"
                    Margin="0,0,8,0" />
            <Button Content="Save"
                    Click="OnSave"
                    Width="76"
                    Padding="0,3"
                    Margin="0,0,8,0"
                    IsDefault="True" />
            <Button Content="Close"
                    Click="OnClose"
                    Width="76"
                    Padding="0,3" />
        </StackPanel>
    </StackPanel>
</Window>
