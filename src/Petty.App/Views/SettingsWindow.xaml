<Window x:Class="Petty.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CozyBackground}"
        Foreground="{StaticResource CozyText}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary Source="../Resources/CozyControls.xaml" /></Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <Border Background="{StaticResource CozySurface}" BorderBrush="{StaticResource CozyEdge}" BorderThickness="1" CornerRadius="14" Padding="18">
            <Border.Effect><DropShadowEffect Color="#845C47" BlurRadius="14" ShadowDepth="2" Opacity="0.14" /></Border.Effect>
        <StackPanel>
        <TextBlock Text="{DynamicResource PetName}" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Style="{StaticResource CozyInput}" MaxLength="24" Margin="0,4,0,0" />
        <TextBlock x:Name="StatusText" MinHeight="18" Margin="0,3,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="AppearanceText"
                   Foreground="{StaticResource CozyMuted}"
                   Margin="0,8,0,0" />

        <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ComboBox x:Name="LanguageSelector" Style="{StaticResource CozySelection}" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="{DynamicResource LanguageSystem}" Tag="system" />
            <ComboBoxItem Content="Русский" Tag="ru" />
            <ComboBoxItem Content="English" Tag="en" />
        </ComboBox>
        </StackPanel>
        </Border>

        <Button x:Name="NewPetButton" Content="{DynamicResource CreateNew}" Style="{StaticResource CozyButton}"
                Click="OnNewPet" HorizontalAlignment="Stretch" Margin="0,20,0,0" />
        <Grid Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
            <Button
                x:Name="CloseButton"
                Content="{DynamicResource Close}"
                Style="{StaticResource CozyButton}"
                Click="OnClose" />
            <Button
                x:Name="SaveButton"
                Content="{DynamicResource Save}"
                Style="{StaticResource CozyPrimaryButton}"
                Click="OnSave"
                Margin="0,0,8,0"
                IsDefault="True"
                Grid.Column="1"
                HorizontalAlignment="Right">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#BF6242" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#873B26" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
            </Button>
        </Grid>
    </StackPanel>
</Window>
