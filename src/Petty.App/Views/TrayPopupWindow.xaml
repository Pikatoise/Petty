<Window x:Class="Petty.App.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Petty" Width="250" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources><ResourceDictionary Source="../Resources/CozyControls.xaml" /></Window.Resources>
    <Border Background="{StaticResource CozyBackground}" BorderBrush="{StaticResource CozyBorder}"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
            <Button Content="{DynamicResource TraySettings}" Style="{StaticResource CozyButton}"
                    Click="OnSettings" Margin="0,0,0,4" />
            <Button 
                Content="{DynamicResource TrayExit}" 
                Style="{StaticResource CozyButton}"
                Click="OnExit"
                Grid.Row="1"/>
		</Grid>
    </Border>
</Window>
