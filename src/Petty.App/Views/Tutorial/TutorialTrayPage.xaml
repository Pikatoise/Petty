<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Petty.App.Views.Tutorial.TutorialTrayPage"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True">
    <ScrollViewer
        x:Name="PageScroll"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8">
                <Viewbox Stretch="Uniform" MaxHeight="140">
                    <Canvas
                        Width="480"
                        Height="220"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        Focusable="False">
                        <Border
                            Canvas.Left="20"
                            Canvas.Top="182"
                            Width="440"
                            Height="2"
                            Background="{StaticResource CozyEdge}"
                            CornerRadius="1" />
                        <Image
                            x:Name="PetImage"
                            Width="128"
                            Height="128"
                            RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border
                            x:Name="TrayIllustration"
                            Canvas.Left="270"
                            Canvas.Top="32"
                            Width="174"
                            Background="{StaticResource CozyBackground}"
                            BorderBrush="{StaticResource CozyBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                            <StackPanel>
                                <TextBlock
                                    Text="Petty"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,12" />
                                <TextBlock Text="{DynamicResource TraySettings}" Margin="0,0,0,10" />
                                <TextBlock Text="{DynamicResource TrayExit}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="TrayBar"
                            Canvas.Left="252"
                            Canvas.Top="172"
                            Width="210"
                            Height="36"
                            Background="{StaticResource CozyEdge}"
                            CornerRadius="8">
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="10,0">
                                <TextBlock
                                    Text="⌃"
                                    FontSize="20"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0" />
                                <Image
                                    x:Name="TrayImage"
                                    Width="24"
                                    Height="24"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock
                                    Text="12:00"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock
                x:Name="PageHeading"
                FontSize="19"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Margin="0,14,0,8"
                Text="{DynamicResource TutorialHeading4}" />
            <TextBlock
                x:Name="PageDescription"
                FontSize="14"
                LineHeight="21"
                TextWrapping="Wrap"
                Text="{DynamicResource TutorialBody4}" />
            <TextBlock
                x:Name="PageNote"
                FontSize="13"
                Foreground="{StaticResource CozyMuted}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Text="{DynamicResource TutorialNote4}" />
        </StackPanel>
    </ScrollViewer>
</Page>
