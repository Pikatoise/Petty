<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Petty.App.Views.Tutorial.TutorialInteractionPage"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True">
    <Page.Resources>
        <ResourceDictionary Source="../../Resources/CozyControls.xaml" />
    </Page.Resources>
    <ScrollViewer
        x:Name="PageScroll"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8">
                <Viewbox Stretch="Uniform" MaxHeight="140">
                    <Canvas
                        Width="480"
                        Height="220"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        Focusable="False">
                        <Border
                            Canvas.Left="20"
                            Canvas.Top="182"
                            Width="440"
                            Height="2"
                            Background="{StaticResource CozyEdge}"
                            CornerRadius="1" />
                        <Image
                            x:Name="PetImage"
                            Width="128"
                            Height="128"
                            RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image x:Name="PropImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border
                            x:Name="ActionMenu"
                            Canvas.Left="180"
                            Canvas.Top="38"
                            Background="{StaticResource CozyBackground}"
                            CornerRadius="8"
                            Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Symbol="SportSoccer24"
                                    FontSize="22"
                                    Margin="0,0,12,0" />
                                <ui:SymbolIcon Symbol="HandRight24" FontSize="22" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock
                x:Name="PageHeading"
                FontSize="19"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Margin="0,14,0,8"
                Text="{DynamicResource TutorialHeading3}" />
            <TextBlock
                x:Name="PageDescription"
                FontSize="14"
                LineHeight="21"
                TextWrapping="Wrap"
                Text="{DynamicResource TutorialBody3}" />
            <TextBlock
                x:Name="PageNote"
                FontSize="13"
                Foreground="{StaticResource CozyMuted}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Text="{DynamicResource TutorialNote3}" />
        </StackPanel>
    </ScrollViewer>
</Page>
