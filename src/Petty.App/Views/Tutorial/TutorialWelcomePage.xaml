<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Petty.App.Views.Tutorial.TutorialWelcomePage"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True">
    <ScrollViewer
        x:Name="PageScroll"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8">
                <Viewbox Stretch="Uniform" MaxHeight="140">
                    <Canvas
                        Width="480"
                        Height="220"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        Focusable="False">
                        <Border
                            Canvas.Left="20"
                            Canvas.Top="182"
                            Width="440"
                            Height="2"
                            Background="{StaticResource CozyEdge}"
                            CornerRadius="1" />
                        <Image
                            x:Name="PetImage"
                            Width="128"
                            Height="128"
                            RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock
                x:Name="PageHeading"
                FontSize="19"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Margin="0,14,0,8"
                Text="{DynamicResource TutorialHeading1}" />
            <TextBlock
                x:Name="PageDescription"
                FontSize="14"
                LineHeight="21"
                TextWrapping="Wrap"
                Text="{DynamicResource TutorialBody1}" />
            <TextBlock
                x:Name="PageNote"
                FontSize="13"
                Foreground="{StaticResource CozyMuted}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Text="{DynamicResource TutorialNote1}" />
        </StackPanel>
    </ScrollViewer>
</Page>
