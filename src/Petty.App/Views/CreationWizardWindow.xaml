<Window x:Class="Petty.App.Views.CreationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Petty"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="192" Height="192" Background="#F0E6D6" CornerRadius="6">
            <Image x:Name="PreviewImage"
                   Width="192"
                   Height="192"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased" />
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock x:Name="HeaderText" Text="Welcome to Petty" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="A small pixel pet for your desktop."
                       Foreground="#6B6258"
                       Margin="0,2,0,12"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Breed:" Width="56" />
                <TextBlock x:Name="BreedText" FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Coat:" Width="56" VerticalAlignment="Center" />
                <ComboBox x:Name="CoatSelector" Width="190" SelectionChanged="OnCoatChanged" />
            </StackPanel>
            <Button Content="Generate coat"
                    Click="OnGenerateCoat"
                    HorizontalAlignment="Left"
                    Margin="56,4,0,0"
                    Padding="10,2" />

            <TextBlock Text="Name" Margin="0,14,0,4" />
            <TextBox x:Name="NameBox" MaxLength="24" Padding="4,2" />
            <TextBlock x:Name="ErrorText"
                       Foreground="#B00020"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Margin="0,3,0,0" />

            <Border x:Name="WarningBorder"
                    Visibility="Collapsed"
                    Background="#FFF4CE"
                    Padding="8"
                    Margin="0,4,0,0"
                    CornerRadius="3">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton"
                        Content="Quit"
                        Click="OnCancel"
                        Width="88"
                        Padding="0,3"
                        Margin="0,0,8,0" />
                <Button x:Name="CreateButton"
                        Content="Create pet"
                        Click="OnCreate"
                        Width="110"
                        Padding="0,3"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
