<Window
    x:Class="Petty.App.Views.CreationWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource NewPetTitle}"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource CozyBackground}"
    Foreground="{StaticResource CozyText}"
    FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="../Resources/CozyControls.xaml" />
    </Window.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="{StaticResource CozyBackground}">
        <Grid x:Name="LayoutGrid" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="PreviewBorder"
                Background="{StaticResource CozySurface}"
                BorderBrush="{StaticResource CozyEdge}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel VerticalAlignment="Center">
                    <Image
                        x:Name="PreviewImage"
                        Width="192"
                        Height="192"
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        RenderOptions.EdgeMode="Aliased" />
                    <Grid Margin="12,8,12,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PreviousCoatButton"
                            Content="←"
                            Style="{StaticResource CozyButton}"
                            Padding="0"
                            MinWidth="0"
                            Width="36"
                            Height="32"
                            FontSize="18"
                            IsEnabled="False"
                            Click="OnPreviousCoat"
                            ToolTip="{DynamicResource PreviousCoat}"
                            AutomationProperties.Name="{DynamicResource PreviousCoat}" />
                        <TextBlock
                            x:Name="CoatPositionText"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource CozyMuted}" />
                        <Button
                            x:Name="NextCoatButton"
                            Grid.Column="2"
                            Content="→"
                            Style="{StaticResource CozyButton}"
                            Padding="0"
                            MinWidth="0"
                            Width="36"
                            Height="32"
                            FontSize="18"
                            IsEnabled="False"
                            Click="OnNextCoat"
                            ToolTip="{DynamicResource NextCoat}"
                            AutomationProperties.Name="{DynamicResource NextCoat}" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="FormPanel"
                Grid.Column="1"
                Margin="22,0,0,0">
                <TextBlock
                    x:Name="HeaderText"
                    Text="{DynamicResource Welcome}"
                    TextWrapping="Wrap"
                    FontSize="22"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{DynamicResource WizardDescription}"
                    Foreground="{StaticResource CozyMuted}"
                    Margin="0,2,0,12"
                    TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource SpeciesLabel}" FontWeight="SemiBold" />
                <ComboBox
                    x:Name="SpeciesSelector"
                    Style="{StaticResource CozySelection}"
                    DisplayMemberPath="Label"
                    SelectionChanged="OnSpeciesChanged"
                    Margin="0,4,0,8" />
                <TextBlock Text="{DynamicResource BreedLabel}" FontWeight="SemiBold" />
                <ComboBox
                    x:Name="BreedSelector"
                    Style="{StaticResource CozySelection}"
                    SelectionChanged="OnBreedChanged"
                    DisplayMemberPath="Label"
                    Margin="0,4,0,0" />

                <TextBlock
                    Text="{DynamicResource NameLabel}"
                    Margin="0,14,0,4"
                    FontWeight="SemiBold" />
                <TextBox
                    x:Name="NameBox"
                    Style="{StaticResource CozyInput}"
                    MaxLength="24" />
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="#B00020"
                    TextWrapping="Wrap"
                    MinHeight="18"
                    Margin="0,3,0,0" />

                <Border
                    x:Name="WarningBorder"
                    Visibility="Collapsed"
                    Background="#FFF4CE"
                    Padding="8"
                    Margin="0,4,0,0"
                    CornerRadius="8">
                    <TextBlock
                        x:Name="WarningText"
                        TextWrapping="Wrap"
                        FontSize="12" />
                </Border>

                <WrapPanel HorizontalAlignment="Right">
                    <Button
                        x:Name="CancelButton"
                        Content="{DynamicResource Quit}"
                        Style="{StaticResource CozyButton}"
                        Click="OnCancel"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left" />
                    <Button
                        x:Name="CreateButton"
                        Content="{DynamicResource CreatePet}"
                        Style="{StaticResource CozyPrimaryButton}"
                        Click="OnCreate"
                        IsDefault="True"
                        HorizontalAlignment="Right">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#BF6242" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#873B26" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
