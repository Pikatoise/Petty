<Window x:Class="Petty.App.Views.CreationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Petty"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CozyBackground}"
        Foreground="{StaticResource CozyText}"
        FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary Source="../Resources/CozyControls.xaml" /></Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource CozySurface}" BorderBrush="{StaticResource CozyEdge}" BorderThickness="1" CornerRadius="14">
            <Image x:Name="PreviewImage"
                   Width="192"
                   Height="192"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased" />
        </Border>

        <StackPanel Grid.Column="1" Margin="22,0,0,0">
            <TextBlock x:Name="HeaderText" Text="Welcome to Petty" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="A small pixel pet for your desktop."
                       Foreground="{StaticResource CozyMuted}"
                       Margin="0,2,0,12"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal">
				<TextBlock
					Text="Breed:"
					Width="56"
					VerticalAlignment="Center"
					FontWeight="SemiBold" />
                <ComboBox x:Name="BreedSelector" Width="210" Style="{StaticResource CozySelection}" SelectionChanged="OnBreedChanged" DisplayMemberPath="BreedId"/>
            </StackPanel>
            <Button Content="Generate coat" Style="{StaticResource CozyButton}"
                    Click="OnGenerateCoat" HorizontalAlignment="Left"
                    Margin="56,4,0,0" Width="210" />

			<TextBlock
				Text="Name"
				Margin="0,14,0,4"
				FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Style="{StaticResource CozyInput}" MaxLength="24" />
            <TextBlock x:Name="ErrorText"
                       Foreground="#B00020"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Margin="0,3,0,0" />

            <Border x:Name="WarningBorder"
                    Visibility="Collapsed"
                    Background="#FFF4CE"
                    Padding="8"
                    Margin="0,4,0,0"
                    CornerRadius="8">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" />
            </Border>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="CancelButton"
					Content="Quit"
					Style="{StaticResource CozyButton}"
					Click="OnCancel"
					Margin="0,0,8,0"
					HorizontalAlignment="Left" />
				<Button
					x:Name="CreateButton"
					Content="Create pet"
					Style="{StaticResource CozyPrimaryButton}"
					Click="OnCreate"
					IsDefault="True"
                    Grid.Column="1"
                    HorizontalAlignment="Right">
					<Button.Resources>
						<SolidColorBrush
							x:Key="ButtonBackgroundPointerOver"
							Color="#BF6242" />
						<SolidColorBrush
							x:Key="ButtonBackgroundPressed"
							Color="#873B26" />
						<SolidColorBrush
							x:Key="ButtonForegroundPressed"
							Color="White" />
					</Button.Resources>
				</Button>
			</Grid>
        </StackPanel>
    </Grid>
</Window>
