<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="SettingsTitle">Petty settings</sys:String>
    <sys:String x:Key="PetName">Pet name</sys:String>
    <sys:String x:Key="Language">Language</sys:String>
    <sys:String x:Key="LanguageSystem">System default</sys:String>
    <sys:String x:Key="CreateNew">Create a new pet…</sys:String>
    <sys:String x:Key="Save">Save</sys:String>
