<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EAD4B0" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DDBD94" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF4DF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFF8E9" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F5E7C9" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFF8E9" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFF8E9" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#845C47" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#3E302A" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#F5E7C9" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#3E302A" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#A84E31" />
            <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>
            <Style x:Key="CozyButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource CozySurface}" />
                <Setter Property="Foreground" Value="{StaticResource CozyText}" />
                <Setter Property="BorderBrush" Value="{StaticResource CozyBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Border.CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CozyPrimaryButton" TargetType="Button" BasedOn="{StaticResource CozyButton}">
                <Setter Property="Background" Value="{StaticResource CozyAccent}" />
                <Setter Property="BorderBrush" Value="{StaticResource CozyAccent}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="CozyInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="{StaticResource CozyBackground}" />
                <Setter Property="Foreground" Value="{StaticResource CozyText}" />
                <Setter Property="BorderBrush" Value="{StaticResource CozyBorder}" />
                <Setter Property="Border.CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CozySelection" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="{StaticResource CozyBackground}" />
                <Setter Property="Foreground" Value="{StaticResource CozyText}" />
                <Setter Property="BorderBrush" Value="{StaticResource CozyBorder}" />
                <Setter Property="Border.CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
