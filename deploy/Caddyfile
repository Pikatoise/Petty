{$PETTY_DOMAIN} {
    request_body {
        max_size 16KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }
    # Access logging stays off: URLs/headers can contain authentication material.
    reverse_proxy api:8080
}
