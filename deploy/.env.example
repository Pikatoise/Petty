# Copy to .env on the server. This file contains no credentials.
PETTY_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
# Use an immutable CI image tag or a registry digest; never track latest in production.
PETTY_SERVER_IMAGE=petty-server:replace-with-reviewed-commit
# Change these together if this subnet overlaps an existing host network.
PETTY_PROXY_SUBNET=172.30.10.0/24
PETTY_PROXY_IP=172.30.10.2
PETTY_API_IP=172.30.10.3
PETTY_BIND_ADDRESS=0.0.0.0
